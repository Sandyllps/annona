<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_card"
    android:padding="20dp">

    <!-- BOTÃO FECHAR -->
    <ImageView
        android:id="@+id/btn_fechar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        android:contentDescription="Fechar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TEXTO DA MENSAGEM -->
    <TextView
        android:id="@+id/txt_mensagem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="Olá! 😊\n\nEstou organizando minha despensa e separei alguns alimentos que estão próximos do vencimento. Caso tenha interesse, você pode copiar a lista abaixo e compartilhar com quem precisar."
        android:textSize="14sp"
        android:textColor="@color/marrom_escuro"
        android:fontFamily="@font/century_gothic"
        app:layout_constraintTop_toBottomOf="@id/btn_fechar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LISTA DE ITENS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_lista_itens"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginTop="12dp"
        android:paddingVertical="4dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/txt_mensagem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- BOTÃO COPIAR -->
    <TextView
        android:id="@+id/btn_copiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copiar lista"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:background="@drawable/bg_btn_copiar"
        android:drawableStart="@drawable/ic_copiar"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/recycler_lista_itens"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
