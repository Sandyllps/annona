<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bege_quase_branco"
    android:paddingTop="20dp"
    tools:context=".TelaDespensaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txt_titulo_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:text="annona"
            android:textColor="@color/marrom_escuro"
            android:textSize="32sp"
            android:fontFamily="@font/century_gothic"
            />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_filtros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/txt_titulo_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:divider="@drawable/divisor"
        android:showDividers="middle">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/vermelho_murango_maduro"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/century_gothic"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Vencidos 1"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/vermelho_murango"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Crítico 5"
                android:textColor="@color/white"
                android:fontFamily="@font/century_gothic"
                android:textSize="11sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/amarelo_sol"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Atenção 2"
                android:textColor="@color/white"
                android:fontFamily="@font/century_gothic"
                android:textSize="11sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/verde_folha"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Seguro 6"
                android:textColor="@color/white"
                android:fontFamily="@font/century_gothic"
                android:textSize="11sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_filtro_status"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#E3F2FD"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_filtros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtrar:"
                android:textColor="#4B4949"
                android:fontFamily="@font/century_gothic"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/txt_status_selecionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abertos"
                    android:textColor="#5E6D88"
                    android:fontFamily="@font/century_gothic"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#438BC4" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#438BC4" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>

</LinearLayout>