<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <!-- BULLET -->
    <TextView
        android:id="@+id/txt_bullet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="•"
        android:textSize="18sp"
        android:textColor="@color/marrom_escuro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- NOME DO ITEM -->
    <TextView
        android:id="@+id/txt_nome_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Leite Fermentado"
        android:textSize="14sp"
        android:textColor="@color/marrom_escuro"
        android:fontFamily="@font/century_gothic"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/txt_bullet"
        app:layout_constraintTop_toTopOf="@id/txt_bullet"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DATA DE VENCIMENTO -->
    <TextView
        android:id="@+id/txt_validade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="1dp"
        android:text="Vence em: 28/01/2026"
        android:textSize="12sp"
        android:textColor="@color/marrom_expresso"
        android:fontFamily="@font/century_gothic"
        app:layout_constraintStart_toEndOf="@id/txt_bullet"
        app:layout_constraintTop_toBottomOf="@id/txt_nome_item"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
