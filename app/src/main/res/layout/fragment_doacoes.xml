<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bege_coco"
    tools:context=".DoacoesFragment">

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TÍTULO DO APP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txt_titulo_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:text="annona"
                android:textColor="@color/marrom_escuro"
                android:textSize="32sp"
                android:fontFamily="@font/century_gothic" />
        </LinearLayout>

        <!-- BOTÃO INFORMAÇÃO -->
        <TextView
            android:id="@+id/btn_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Info"
            android:textStyle="italic"
            android:textSize="14dp"
            android:textColor="@color/marrom_cafe"
            android:drawableStart="@drawable/ic_informacao"
            android:background="@drawable/bg_dialog_arredondado"
            android:fontFamily="@font/century_gothic" />

        <!-- TEXTO EXPLICATIVO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <TextView
                android:id="@+id/txt_explicacao_doacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="14dp"
                android:text="Aqui estão listados alimentos próximos do vencimento. Caso perceba que não conseguirá consumi-los a tempo, você pode gerar uma lista para doação e compartilhar."
                android:textColor="@color/marrom_escuro"
                android:textSize="13sp"
                android:fontFamily="@font/century_gothic"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- LISTA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_doacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:paddingHorizontal="2dp"
            android:clipToPadding="false"/>

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btn_gerar_lista_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:paddingVertical="16dp"
            android:text="Gerar lista de doação"
            android:textAllCaps="false"
            android:textColor="@color/bege_champagne"
            android:textSize="18dp"
            android:backgroundTint="@color/bege_chai"
            android:fontFamily="@font/century_gothic"
            android:textStyle="bold"/>
    </LinearLayout>

</FrameLayout>
