<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bege_coco"
    tools:context=".DoacoesFragment">

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CABEÇALHO VERDE -->

        <LinearLayout
            android:id="@+id/header_verde"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:background="@color/bege_coco"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_titulo_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="annona"
                android:textColor="@color/marrom_cafe"
                android:textSize="32sp"
                android:fontFamily="@font/century_gothic"/>
        </LinearLayout>

        <!-- ESPAÇO PARA SOBREPOSIÇÃO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="70dp" />

        <!-- LISTA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_doacoes"
            android:layout_width="match_parent"
            android:layout_height="2000dp"
            android:layout_weight="1"
            android:paddingHorizontal="1dp"
            android:clipToPadding="false"/>

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btn_gerar_lista_doacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="11dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:paddingVertical="14dp"
            android:text="Gerar lista de doação"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            android:backgroundTint="@color/bege_chai"
            android:fontFamily="@font/century_gothic"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- TEXTO EXPLICATIVO SOBREPOSTO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="90dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <TextView
            android:id="@+id/txt_explicacao_doacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Aqui estão listados alimentos próximos do vencimento. Caso perceba que não conseguirá consumi-los a tempo, você pode gerar uma lista para doação e compartilhar."
            android:textColor="@color/marrom_escuro"
            android:textSize="12sp"
            android:fontFamily="@font/century_gothic"/>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
