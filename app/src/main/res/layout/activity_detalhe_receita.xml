<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6EFE6">

    <!-- Botão voltar -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_voltar"
        android:contentDescription="Voltar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Imagem principal -->
            <ImageView
                android:id="@+id/imgReceita"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <!-- Nome -->
            <TextView
                android:id="@+id/txtNomeReceita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feijoada"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtTagReceita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINCIPAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tag_receita"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="4dp"/>

            <!-- Tempo e porções -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtTempoReceita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo: 50 min"
                    android:textSize="14sp"
                    android:layout_marginEnd="16dp"
                    android:textColor="#6D4C41" />

                <TextView
                    android:id="@+id/txtPorcoesReceita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Porções: 4"
                    android:textSize="14sp"
                    android:textColor="#6D4C41" />

            </LinearLayout>

            <!-- Descrição -->
            <TextView
                android:id="@+id/txtDescricaoReceita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição da receita"
                android:textSize="14sp"
                android:textColor="#5D4037"
                android:layout_marginTop="12dp" />

            <!-- Ingredientes -->
            <TextView
                android:layout_marginTop="20dp"
                android:text="Ingredientes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtIngredientesReceita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#5D4037"
                android:layout_marginTop="8dp" />

            <!-- Modo de preparo -->
            <TextView
                android:layout_marginTop="20dp"
                android:text="Modo de Preparo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvModoPreparo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
