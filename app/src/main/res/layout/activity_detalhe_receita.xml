<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF3EA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- IMAGEM -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgReceita"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/feijoada_capa" />

                <ImageView
                    android:id="@+id/btnVoltar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="16dp"
                    android:src="@drawable/btn_voltar_receitas"
                    android:contentDescription="Voltar"
                    android:scaleType="center"
                    android:layout_gravity="top|start" />

                <!-- TAG sobre a imagem -->
                <TextView
                    android:id="@+id/txtTagReceita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prato: Principal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:background="@drawable/bg_tag_receita"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"/>

            </FrameLayout>

            <!-- NOME + TEMPO/PORÇÕES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/txtNomeReceita"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:text="Feijoada"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="35dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTempoReceita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tempo: 50min"
                        android:textSize="14sp"
                        android:textColor="#6D4C41" />

                    <TextView
                        android:id="@+id/txtPorcoesReceita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Porções: 4"
                        android:textSize="14sp"
                        android:textColor="#6D4C41" />
                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:src="@drawable/linha_divisoria_nome" />

            <TextView
                android:id="@+id/txtDescricaoReceita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="5dp"
                android:text="Descrição da receita"
                android:textSize="14sp"
                android:textColor="#5D4037" />

            <!-- INGREDIENTES -->
            <TextView
                android:text="Ingredientes"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />

            <ImageView
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:src="@drawable/linha_divisoria_ingemodop"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/txtIngredientesReceita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="3dp"

                android:textSize="13sp"
                android:textColor="#5D4037" />

            <!-- MODO DE PREPARO -->
            <TextView
                android:text="Modo de Preparo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />

            <ImageView
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:src="@drawable/linha_divisoria_ingemodop"
                android:layout_marginStart="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvModoPreparo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
