<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bege_quase_branco"
    tools:context=".DetalheReceitaFragment">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txt_titulo_receita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_gravity="center"
        android:text="Feijoada"
        android:textSize="26sp"
        android:textColor="@color/marrom_escuro"
        android:fontFamily="@font/century_gothic"
        android:textStyle="bold"/>

    <!-- CONTEÚDO (placeholder por enquanto) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"
        android:text="Detalhe da receita"
        android:textSize="14sp"
        android:textColor="@color/marrom_escuro"/>
</LinearLayout>
