<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:backgroundTint="#DFD0BF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- IMAGEM + NÚMERO -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp">

            <ImageView
                android:id="@+id/imgEtapa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:id="@+id/txtNumeroEtapa"
                android:layout_width="27dp"
                android:layout_height="28dp"
                android:layout_margin="3dp"
                android:background="@drawable/quadrado_numero"
                android:gravity="center"
                android:text="1"
                android:textColor="#670010"
                android:textStyle="bold"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- DESCRIÇÃO -->
        <TextView
            android:id="@+id/txtDescricaoEtapa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Descrição do passo da receita"
            android:textColor="#4E342E"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
